@model Q2.Models.TrainerDetailDTO
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>Trainer Specifications</title>
</head>
<body>
<div class="analyze-wrap">
    <div class="trainer-card">
        <h3>Trainer Specifications</h3>
        <div class="card-item"><strong>Trainer ID:</strong> <span id="span_@Model.TrainerID">@Model.TrainerID</span></div>
        <div class="card-item"><strong>Trainer Name:</strong> <span id="span_trainerName">@Model.TrainerName</span></div>
        <div class="card-item"><strong>Experience Years:</strong> <span id="span_experienceYears">@Model.ExperienceYears</span> years</div>
    </div>

    <h4 style="margin-bottom: 15px; border-bottom: 1px solid #cbd5e1; padding-bottom: 10px; width: 750px; color: #334155;">Scheduled Member Sessions</h4>

    <table class="sessions-table">
        <thead>
            <tr>
                <th style="width: 250px;">Member Name</th>
                <th style="width: 200px;">Session Time</th>
                <th style="width: 150px;">Duration</th>
                <th style="width: 180px;">Session Intensity Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BookingSessions != null)
            {
                foreach (var s in Model.BookingSessions)
                {
                    <tr>
                        <td id="td_member_@s.MemberID">@s.MemberName</td>
                        <td id="td_time_@s.BookingID">@s.SessionTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td id="td_duration_@(s.BookingID)_@(s.MemberID)">@(s.DurationMinutes) mins</td>
                        @if (s.DurationMinutes > 60)
                        {
                            <td id="td_intensity_@(s.BookingID)_@(s.MemberID)" style="color: red; font-weight: bold;">
                                <span class="badge-high" style="color: red; font-weight: bold;">High Intensity</span>
                            </td>
                        }
                        else
                        {
                            <td id="td_intensity_@(s.BookingID)_@(s.MemberID)" style="color: green;">
                                <span class="badge-std" style="color: green;">Standard</span>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
</body>
</html>
