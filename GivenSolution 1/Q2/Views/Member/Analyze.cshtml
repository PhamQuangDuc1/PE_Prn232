@model Q2.Models.MemberDetailDTO
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>Member Profile Analysis</title>
    <style>
        body { font-family: Segoe UI, Tahoma, Geneva, Verdana, sans-serif; margin: 30px; color: #1e293b; }
        .member-card { border: 1px solid #e2e8f0; border-left: 4px solid #10b981; padding: 16px 24px; border-radius: 6px; max-width: 450px; margin-bottom: 24px; }
        .member-card h3 { color: #047857; margin-top: 0; }
        .card-item { margin: 8px 0; font-size: 14px; display: flex; }
        .card-item strong { width: 140px; display: inline-block; }
        .sessions-table { border-collapse: collapse; width: 780px; font-size: 14px; }
        .sessions-table thead th { background: #f1f5f9; text-align: left; padding: 10px 12px; border-bottom: 2px solid #334155; }
        .sessions-table tbody td { padding: 12px; border-bottom: 1px solid #e2e8f0; }
        .badge-std { background: #dcfce7; color: green; padding: 4px 10px; border-radius: 4px; font-weight: 600; font-size: 12px; }
        .badge-high { background: #fee2e2; color: red; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 12px; }
    </style>
</head>
<body>
<div class="analyze-wrap">
    <div class="member-card">
        <h3>Member Profile Analysis</h3>
        <div class="card-item"><strong>Member ID:</strong> <span id="span_@Model.MemberID">@Model.MemberID</span></div>
        <div class="card-item"><strong>Full Name:</strong> <span id="span_fullName">@Model.FullName</span></div>
        <div class="card-item"><strong>Join Date:</strong> <span id="span_joinDate">@Model.JoinDate.ToString("yyyy-MM-dd")</span></div>
        <div class="card-item"><strong>Current Package:</strong> @Model.PackageName (@Model.PackagePrice.ToString("N0") VND)</div>
    </div>

    <h4 style="margin-bottom: 15px; border-bottom: 1px solid #cbd5e1; padding-bottom: 10px; width: 750px; color: #334155;">Attended Sessions Log</h4>

    <table class="sessions-table">
        <thead>
            <tr>
                <th style="width: 250px;">Trainer Name</th>
                <th style="width: 200px;">Session Time</th>
                <th style="width: 150px;">Duration</th>
                <th style="width: 200px;">Financial Value Tier</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Sessions != null)
            {
                foreach (var s in Model.Sessions)
                {
                    var estimatedCost = s.DurationMinutes * 5000;
                    <tr>
                        <td id="td_trainer_@s.BookingID">@s.TrainerName</td>
                        <td id="td_time_@s.BookingID">@s.SessionTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td id="td_duration_@s.BookingID">@(s.DurationMinutes) mins</td>
                        @if (estimatedCost >= 400000)
                        {
                            <td id="td_tier_@s.BookingID" style="color: red; font-weight: bold;">
                                <span class="badge-high" style="color: red; font-weight: bold;">High Premium Session</span>
                            </td>
                        }
                        else
                        {
                            <td id="td_tier_@s.BookingID" style="color: green;">
                                <span class="badge-std" style="color: green;">Standard Session</span>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
</body>
</html>
